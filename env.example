MARIADB_VERSION=11.4
MARIADB_CONTAINER_NAME=seq-mariadb
TZ=Asia/Seoul

MARIADB_DATABASE=seq_metadata
MARIADB_USER=seq_app
MARIADB_PASSWORD=replace_with_strong_password
MARIADB_ROOT_PASSWORD=replace_with_strong_root_password

# Host 실행: 127.0.0.1
# 동일 Docker Compose 네트워크의 컨테이너 실행: mariadb
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_CONNECT_TIMEOUT=10
